# 10) Handle URL messages
# =======================
@bot.message_handler(func=lambda m: bool(m.text and URL_RE.search(m.text)))
def on_url(message):
    url = URL_RE.search(message.text).group(1).strip()
    bot.reply_to(message, "🔎 بفحص الرابط...")

    try:
        info = extract_info(url)

        title = info.get("title", "بدون عنوان")
        duration = info.get("duration") or 0
        uploader = info.get("uploader") or info.get("channel") or "غير معروف"

        if duration and duration > MAX_DURATION_SEC:
            bot.reply_to(message, f"❌ المدة طويلة جدًا ({fmt_dur(duration)}). الحد الأقصى 3 ساعات.")
            return

        qs, q_to_fmt, q_sizes = build_video_choices(info)

        # keep only qualities from MIN_QUALITY_P and up
        qs_shown = [q for q in qs if q >= MIN_QUALITY_P]

        lines = [
            "✅ تم العثور على المحتوى:",
            f"• العنوان: {title}",
            f"• الحساب/القناة: {uploader}",            f"• المدة: {fmt_dur(duration)}",
            "",
            f"🎥 اختر الجودة (من {MIN_QUALITY_P}p وطالع):"
        ]

        kb = telebot.types.InlineKeyboardMarkup(row_width=2)

        if qs_shown:
            # list all available qualities >= MIN_QUALITY_P
            for q in qs_shown:
                size_txt = fmt_mb(q_sizes.get(q))
                kb.add(
                    telebot.types.InlineKeyboardButton(
                        f"🎥 {q}p ({size_txt})",
                        callback_data=f"v|{message.chat.id}|{message.message_id}|{q}"
                    )
                )
        else:
            lines.append("⚠️ لم أجد جودات MP4 مناسبة للاختيار (بدون أفضل جودة تلقائيًا).")
            lines.append("جرب رابط آخر أو استخدم صوت MP3.")

        # audio button always available
        kb.add(
            telebot.types.InlineKeyboardButton(
                "🎧 صوت MP3",
                callback_data=f"a|{message.chat.id}|{message.message_id}|0"
            )
        )

        bot.send_message(message.chat.id, "\n".join(lines), reply_markup=kb)

        STATE[(message.chat.id, message.message_id)] = {
            "url": url,
            "title": title,
            "duration": duration,
            "q_to_fmt": q_to_fmt,
            "q_sizes": q_sizes,
        }

    except Exception as e:
        bot.reply_to(message, f"❌ فشل قراءة الرابط.\n{type(e).__name__}")


